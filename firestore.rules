rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shared/state {
      allow read, write: if request.auth != null
        && request.auth.uid == 'Lsuxm4H1s0Zm1sy93P378Bce2tt1';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
