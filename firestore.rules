rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() { return request.auth != null && request.auth.uid == 'Lsuxm4H1s0Zm1sy93P378Bce2tt1'; }
    match /shared/state {
      allow read, create: if owner();
      allow update: if owner() && (resource.data.get('storageVersion', 1) != 2
        || request.resource.data.get('storageVersion', 1) == 2);
    }
    match /stateParts/{part} {
      allow read, delete: if owner();
      allow create: if owner()
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 180000;
      allow update: if owner() && request.resource.data == resource.data;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
